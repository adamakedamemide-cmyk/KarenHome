NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/real_estate
DATABASE_SSL=false
DATABASE_POOL_MAX=20
JWT_SECRET=replace-with-strong-random-secret-of-at-least-43-characters
JWT_ISSUER=enterprise-real-estate-platform
JWT_AUDIENCE=real-estate-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ENABLE_API_DOCS=true
